## ─── LLM Provider ─────────────────────────────
## Options: "mistral" (free), "gemini" (free), "claude" (paid)
LLM_PROVIDER=mistral

## ─── Mistral (FREE — recommended for demo) ────
## Get your key: https://console.mistral.ai → API Keys
## No credit card needed, just phone verification
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

## ─── Gemini (FREE alternative) ─────────────────
## Get your key: https://aistudio.google.com → Get API key
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash

## ─── Claude (PAID — best quality) ──────────────
## Get your key: https://platform.claude.com → API Keys
# ANTHROPIC_API_KEY=your-claude-key-here
# CLAUDE_MODEL=claude-sonnet-4-20250514

## ─── Database & Storage ────────────────────────
DATABASE_URL=sqlite:///./data/tutor.db
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads
